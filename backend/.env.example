OPENF1_BASE_URL=https://api.openf1.org/v1
# Required while a live F1 session is on: public historical access is locked.
# Sponsor: https://openf1.org/auth.html  then POST username/password to /token
OPENF1_USERNAME=
OPENF1_PASSWORD=
# Optional: paste a Bearer token instead of username/password (expires ~1 hour)
OPENF1_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Preview + production Vercel hosts (browser → Railway). Override empty to disable.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# LLM — DeepSeek (OpenAI-compatible). https://api-docs.deepseek.com/
# Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Optional aliases: OPENAI_API_KEY is used only if DEEPSEEK_API_KEY is empty
OPENAI_API_KEY=

# Commercial search (Phase 2) — dashboard GET does not call this
TAVILY_API_KEY=

# Supabase fact store (optional; SQLite fallback). Paste when you have them.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Pre-2023 race calendar
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
SEASON_WINDOW_YEARS=10


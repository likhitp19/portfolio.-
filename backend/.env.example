OPENF1_BASE_URL=https://api.openf1.org/v1
# Required while a live F1 session is on: public historical access is locked.
# Sponsor: https://openf1.org/auth.html  then POST username/password to /token
OPENF1_USERNAME=
OPENF1_PASSWORD=
# Optional: paste a Bearer token instead of username/password (expires ~1 hour)
OPENF1_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Preview + production Vercel hosts (browser → Railway). Override empty to disable.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# LLM — DeepSeek (OpenAI-compatible). https://api-docs.deepseek.com/
# Key: https://platform.deepseek.com/api_keys
# Used by the commercial chat desk (Generalist / Analyst), not the Race Steward.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Optional aliases: OPENAI_API_KEY is used only if DEEPSEEK_API_KEY is empty
OPENAI_API_KEY=

# Race Steward (Phase 7) — OpenRouter for Qwen-VL + DeepSeek-R1.
# Key: https://openrouter.ai/keys
# Without this key, /api/steward still runs on incident_hint + OpenF1 + heuristic verdict.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
STEWARD_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct
STEWARD_REASON_MODEL=deepseek/deepseek-r1
CHROMA_PERSIST_DIR=data/chroma_fia
STEWARD_USE_CHROMA=true

# Protest Engine Phase 1 — Pinecone legal RAG (never commit real keys)
# Create a Serverless index (e.g. fia-sporting-regulations, cosine, 1536-dim).
PINECONE_API_KEY=
PINECONE_INDEX=fia-sporting-regulations
PINECONE_NAMESPACE=fia-sporting-2026
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Embeddings for ingest + Pinecone query (OpenRouter or OpenAI)
EMBEDDING_MODEL=openai/text-embedding-3-small
# Must match existing Pinecone index dimension (text-embedding-3-small supports Matryoshka dims).
EMBEDDING_DIMENSIONS=512
FIA_PDFS_DIR=app/data/pdfs

# Commercial search — dashboard GET does not call this
TAVILY_API_KEY=

# Supabase fact store. Create the table first: SQL in backend/app/data/commercial_facts.sql
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Preload 2024/2025 dashboard into memory on boot (set false in tests).
DASHBOARD_PRELOAD=true

# Pre-2023 race calendar
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
SEASON_WINDOW_YEARS=10

